# ===========================================
# SpecPilot Environment Variables
# ===========================================
# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง
# ห้าม commit ไฟล์ .env.local

# Supabase (สร้างได้ที่ https://supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service Role Key — ใช้เฉพาะฝั่ง Server / Import scripts เท่านั้น
# ห้ามใส่ใน Client Code หรือ NEXT_PUBLIC_*
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# หมายเหตุ:
# - เฟส 2: ใช้สำหรับรัน migration และ import
# - เฟส 3+: ใช้เชื่อมต่อจาก Next.js Server Components / API Routes
